# Optional local configuration. Copy to .env. Never commit private .env values.
RECALLAI_DATA_DIR=data/private
# RECALLAI_DB_PATH=data/private/recallai.sqlite3
RECALLAI_SUMMARY_MODEL=Falconsai/text_summarization
RECALLAI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RECALLAI_OFFLINE=0
RECALLAI_TIMEZONE=Asia/Kolkata
# Optional Unicode font for PDF exports on Linux deployments:
# RECALLAI_PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
